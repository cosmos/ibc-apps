# make local-image-icq-demo
# docker run --rm -it icq-demo:local q interquery

FROM golang:1.26-alpine AS builder

RUN set -eux; apk add --no-cache git libusb-dev linux-headers gcc musl-dev make;

ENV GOPATH=""

# The demo module replaces async-icq with ../../, so keep that layout.
WORKDIR /src/async-icq

COPY go.mod go.sum ./
COPY testing/demo-simapp/go.mod testing/demo-simapp/go.sum ./testing/demo-simapp/

WORKDIR /src/async-icq/testing/demo-simapp

RUN go mod download

COPY . /src/async-icq

RUN make build BUILDDIR=/go/build

FROM alpine:3.21

COPY --from=builder /go/build/* /bin/icq-demo

ENTRYPOINT ["/bin/icq-demo"]